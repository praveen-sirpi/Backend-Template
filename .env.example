# Copy to .env and adjust. Every variable is optional; defaults live in src/core/config.py.

# --- Application ---
APP_NAME="Backend Template"
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production | test
DEBUG=false
API_PREFIX=/api/v1
DOCS_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console               # console (colored, for humans) | json (for log aggregators)
LOG_FILE=                        # e.g. logs/app.log -> rotating JSON file (10 MB x 5)

# --- CORS: comma-separated origins (empty = CORS disabled) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# PostgreSQL (start it with: docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
# No Docker? Use SQLite for local development instead:
# DATABASE_URL=sqlite+aiosqlite:///./app.db
DB_ECHO=false                    # log every SQL statement
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis (optional: leave empty to disable) ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
